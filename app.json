{
  "expo": {
    "name": "Apna Doctoro",
    "slug": "raphson",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ezzmed",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "statusBar": {
        "hidden": true
      },
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.neel_priyansh.App"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212",
          "dark": {
            "backgroundColor": "#121212"
          },
          "android": {
            "imageWidth": 250
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use the current location when registering a doctor."
        }
      ],
      "@react-native-google-signin/google-signin",
      "@maplibre/maplibre-react-native",
      "expo-build-properties",
      "./plugins/withCoreSplashscreen",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "793b423c-57ff-479f-a1df-d079d68434f1"
      }
    },
    "owner": "raphsons-team"
  }
}
